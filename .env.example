SUPABASE_PUBLISHABLE_KEY="sb_publishable_84NpiaDV0dfaFOWFbTFdwA_AKFby-Lo"
VITE_SUPABASE_ANON_KEY="sb_publishable_84NpiaDV0dfaFOWFbTFdwA_AKFby-Lo"
# Server-only secret key (Never expose in client-side code)
SUPABASE_SECRET_KEY="your-secret-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
